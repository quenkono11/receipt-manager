{
  "name": "receipt-manager",
  "version": "1.1.1",
  "description": "Receipt manager / Belegverwaltung",
  "main": "main.js",
  "author": "Receipt Manager",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.mjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.receiptmanager",
    "productName": "Receipt Manager",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
