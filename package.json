{
  "name": "receipt-manager",
  "version": "1.0.0",
  "description": "Receipt manager / Belegverwaltung",
  "main": "main.js",
  "author": "Receipt Manager",
  "license": "GPL v3",
  "scripts": {
    "start": "electron-forge start",
    "test": "node test/logic.test.mjs",
    "dist": "electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.example.receiptmanager",
    "productName": "Receipt Manager",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
